# Switch agent credentials.
# Switch Console injects these into a managed agent's session. For a
# headless Clerk process, copy the values from the agent's page.
SWITCH_API_ENDPOINT=https://api.switchagents.ai
SWITCH_API_TOKEN=replace-with-agent-api-key
SWITCH_AGENT_ID=replace-with-agent-id

# Often the same host as SWITCH_API_ENDPOINT; used by the WebSocket runtime.
SWITCH_API_URL=https://api.switchagents.ai

# Vouch runtime state. Defaults to ~/.vouch when unset.
VOUCH_HOME=.vouch

# Optional: restrict the local web UI to a known host.
VOUCH_HOST=127.0.0.1
VOUCH_PORT=8787
